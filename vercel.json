{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/ops",
      "destination": "/admin.html"
    },
    {
      "source": "/ops/",
      "destination": "/admin.html"
    },
    {
      "source": "/invite/:token",
      "destination": "/"
    },
    {
      "source": "/connectors",
      "destination": "/"
    },
    {
      "source": "/connectors/",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/contact/",
      "destination": "/"
    },
    {
      "source": "/partneronboarding",
      "destination": "/api/fetch/context?partner=1"
    },
    {
      "source": "/partneronboarding/",
      "destination": "/api/fetch/context?partner=1"
    }
  ]
}
