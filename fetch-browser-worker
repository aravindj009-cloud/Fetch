RUN apt-get update && apt-get install -y --no-install-recommends     chromium     ca-certificates     fonts-liberation     fonts-noto-color-emoji     fonts-dejavu-core     fonts-freefont-ttf     wget     curl     && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py .

ENV BROWSER_USE_CHROME_NO_SANDBOX=1

EXPOSE 8080

CMD ["python", "main.py"]


